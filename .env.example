# devnet | mainnet
CLUSTER=devnet
# RPC used by the server to verify funding and relay claims (defaults to the public cluster RPC)
HB_RPC=https://api.devnet.solana.com
# RPC exposed to browsers (defaults to HB_RPC). Use a rate-limited/public key here, never a private one.
HB_PUBLIC_RPC=
PORT=5173
# JSON store path
DB=./data.json
# TEST=1 enables /api/test/expire/:id (never enable in production)
TEST=
# Protocol fee: 1% of every packet is sent to this treasury in the funding tx (server verifies it).
# Unset = fee disabled (UI shows 0%). Buybacks/burns are done manually from this wallet with public txs.
HB_TREASURY=5f3Fkdfne6X7rpiSnQh91s92kssX23Dn5d9ZJafV1P4Y
# Optional holder exemption: wallets holding >= HB_HOLDER_MIN (whole tokens) of HB_HONGBAO_MINT pay no fee. Unset = skip.
HB_HONGBAO_MINT=
HB_HOLDER_MIN=
